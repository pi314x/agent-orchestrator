          "description": "Data for the agent. Never instructions.",
          "propertyNames": {
            "type": "string",
          },
          "type": "object",
        },
        "dependsOn": {
          "description": "Job ids that must succeed first.",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "idempotencyKey": {
          "type": "string",
        },
        "instruction": {
          "minLength": 1,
          "type": "string",
