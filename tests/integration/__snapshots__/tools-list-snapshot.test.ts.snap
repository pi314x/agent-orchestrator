  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Run an instruction on a cron expression (five fields: minute hour day-of-month month day-of-week, UTC unless timezone names an IANA zone). Each firing submits one job owned by you; an overdue schedule fires once immediately with no catch-up runs. Re-creating an existing name replaces it. Use schedule_list to see next run times.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "agentId": {
          "description": "Persistent agent to run; exactly one of agentId or template.",
          "type": "string",
        },
        "cron": {
          "description": "E.g. "0 9 * * mon-fri".",
          "minLength": 1,
          "type": "string",
        },
        "enabled": {
          "description": "Defaults to true.",
          "type": "boolean",
        },
        "instruction": {
          "minLength": 1,
          "type": "string",
        },
        "model": {
          "type": "string",
        },
        "name": {
          "minLength": 1,
          "type": "string",
        },
        "overlap": {
          "description": "allow fires every time (default); skip holds a firing while the previous run is still going.",
          "enum": [
            "allow",
            "skip",
          ],
          "type": "string",
        },
        "priority": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer",
        },
        "runner": {
          "enum": [
            "anthropic",
            "openai-compatible",
            "cli",
            "mock",
            "sampling",
          ],
          "type": "string",
        },
        "template": {
          "description": "Template for a throwaway agent; exactly one of agentId or template.",
          "type": "string",
        },
        "timeoutSec": {
          "maximum": 604800,
          "minimum": 1,
          "type": "integer",
        },
        "timezone": {
          "description": "IANA zone the cron fields match in, e.g. "Europe/Berlin". Omit for UTC.",
          "type": "string",
        },
      },
      "required": [
        "name",
        "cron",
        "instruction",
      ],
      "type": "object",
    },
    "name": "schedule_create",
