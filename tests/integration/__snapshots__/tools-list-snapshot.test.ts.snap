              "agentName",
              "state",
              "depth",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "totalCostUsd": {
          "type": "number",
        },
        "totalDurationMs": {
          "type": "number",
        },
      },
      "required": [
        "spans",
        "totalDurationMs",
        "totalCostUsd",
      ],
      "type": "object",
    },
    "title": "Get a trace",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Summarize job counts, tokens and cost grouped by agent, model or backend. Remote agents show call counts and only whatever cost they self-report, since we cannot see their token usage. Use trace_get for one run in detail.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "groupBy": {
          "default": "agent",
          "enum": [
            "agent",
            "model",
            "backend",
          ],
          "type": "string",
        },
        "limit": {
          "default": 500,
          "maximum": 1000,
          "minimum": 1,
          "type": "integer",
        },
        "since": {
          "description": "ISO timestamp; defaults to all time.",
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "usage_report",
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "groups": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "costUsd": {
                "type": "number",
              },
              "durationMs": {
                "type": "number",
              },
              "failed": {
                "type": "number",
              },
              "inputTokens": {
                "type": "number",
              },
              "jobs": {
                "type": "number",
              },
              "key": {
                "type": "string",
              },
              "outputTokens": {
                "type": "number",
              },
              "succeeded": {
                "type": "number",
              },
            },
            "required": [
              "key",
              "jobs",
              "succeeded",
              "failed",
              "inputTokens",
              "outputTokens",
              "costUsd",
              "durationMs",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "totals": {
          "additionalProperties": false,
          "properties": {
            "costUsd": {
              "type": "number",
            },
            "jobs": {
              "type": "number",
            },
            "tokens": {
              "type": "number",
            },
          },
          "required": [
            "jobs",
            "costUsd",
            "tokens",
          ],
          "type": "object",
        },
      },
      "required": [
        "groups",
        "totals",
      ],
      "type": "object",
    },
    "title": "Report usage",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Report orchestrator health, version, active tool profile, queue depth, schema state and your own caller identity. The caller ownerId is the granteeId to hand someone so they can share an agent or memory namespace with you via agent_share or memory_share. Not for inspecting individual work — use job_get or job_list for that.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {},
      "type": "object",
    },
    "name": "orchestrator_status",
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "a2a": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
            },
          },
          "required": [
            "enabled",
          ],
          "type": "object",
        },
        "caller": {
          "additionalProperties": false,
          "properties": {
            "isAdmin": {
              "type": "boolean",
            },
            "ownerId": {
              "type": "string",
            },
          },
          "required": [
            "ownerId",
            "isAdmin",
          ],
          "type": "object",
        },
        "database": {
          "additionalProperties": false,
          "properties": {
            "latestSchemaVersion": {
              "type": "number",
            },
            "migrationsPending": {
              "type": "boolean",
            },
            "schemaVersion": {
              "type": "number",
            },
          },
          "required": [
            "schemaVersion",
            "latestSchemaVersion",
            "migrationsPending",
          ],
          "type": "object",
        },
        "jobs": {
          "additionalProperties": false,
          "properties": {
            "blocked": {
              "type": "number",
            },
            "queued": {
              "type": "number",
            },
            "running": {
              "type": "number",
            },
          },
          "required": [
            "queued",
            "running",
            "blocked",
          ],
          "type": "object",
        },
        "limits": {
          "additionalProperties": false,
          "properties": {
            "maxConcurrency": {
              "type": "number",
            },
            "maxDepth": {
              "type": "number",
            },
          },
          "required": [
            "maxConcurrency",
            "maxDepth",
          ],
          "type": "object",
        },
        "pqc": {
          "additionalProperties": false,
          "properties": {
            "algorithms": {
              "items": {
                "type": "string",
              },
              "type": "array",
            },
            "atRest": {
              "type": "boolean",
            },
            "cardSigned": {
              "type": "boolean",
            },
          },
          "required": [
            "algorithms",
            "atRest",
            "cardSigned",
          ],
          "type": "object",
        },
        "protocolEra": {
          "type": "string",
        },
        "status": {
          "enum": [
            "ok",
            "degraded",
          ],
          "type": "string",
        },
        "toolProfile": {
          "type": "string",
        },
        "transport": {
          "type": "string",
        },
        "uptimeSec": {
          "type": "number",
        },
        "version": {
          "type": "string",
        },
      },
      "required": [
        "status",
        "version",
        "uptimeSec",
        "toolProfile",
        "transport",
        "protocolEra",
        "database",
        "jobs",
        "limits",
        "a2a",
        "caller",
        "pqc",
      ],
      "type": "object",
    },
    "title": "Orchestrator status",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "List the local execution backends and whether each is usable right now, including missing credentials. Check this when a job fails with RUNNER_FAILED, or before creating an agent that names a specific runner. Remote A2A agents are not runners and never appear here.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {},
      "type": "object",
    },
    "name": "runner_list",
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
