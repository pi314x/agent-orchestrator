          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "transport": {
          "anyOf": [
            {
              "properties": {
                "args": {
                  "items": {
                    "type": "string",
                  },
                  "type": "array",
                },
                "command": {
                  "minLength": 1,
                  "type": "string",
                },
                "cwd": {
                  "type": "string",
                },
                "type": {
                  "const": "stdio",
                  "type": "string",
                },
              },
              "required": [
                "type",
                "command",
              ],
              "type": "object",
            },
            {
              "properties": {
                "type": {
                  "const": "http",
                  "type": "string",
                },
                "url": {
                  "format": "uri",
                  "type": "string",
                },
              },
              "required": [
                "type",
                "url",
              ],
              "type": "object",
            },
          ],
        },
      },
      "required": [
        "name",
        "transport",
      ],
      "type": "object",
    },
    "name": "toolserver_register",
