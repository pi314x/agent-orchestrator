  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Grant one named user read and delegate access to an agent you own — peer-to-peer sharing, private to exactly that grantee. The share starts pending and confers nothing until the grantee accepts it with agent_share_accept; list it with agent_share_list. Nothing is shared by default; this is separate from the admin-only shared flag on agent_create, which is visible to everyone. granteeId is that user’s ownerId (the OAuth subject, e.g. their Entra object id). Revoke with agent_unshare.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "agentId": {
          "type": "string",
        },
        "granteeId": {
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "agentId",
        "granteeId",
      ],
      "type": "object",
    },
