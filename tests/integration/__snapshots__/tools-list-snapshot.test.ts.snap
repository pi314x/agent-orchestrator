      "readOnlyHint": false,
    },
    "description": "Turn a goal into a draft workflow spec using a planner agent. The draft is returned, never executed, with draftValid saying whether it already passes the same validation workflow_define enforces — review it, then pass it to workflow_define or workflow_start. Use delegate when you want the work done rather than planned.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "allowedTemplates": {
          "items": {
