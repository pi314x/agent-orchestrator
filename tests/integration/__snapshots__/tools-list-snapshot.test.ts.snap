            "events",
            "createdAt",
          ],
          "type": "object",
        },
      },
      "required": [
        "webhook",
      ],
      "type": "object",
    },
    "title": "Register a completion callback",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "List registered completion callbacks and the settle events each receives.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {},
      "type": "object",
    },
    "name": "webhook_list",
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
