  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Delete finished jobs, runs and their linked events, approvals, artifacts and messages older than a cutoff — or, with dryRun, report exactly what would go without touching anything. Agents, templates, presets, memory and unlinked artifacts are never touched. Refuses without an explicit cutoff — pass olderThanDays or set ORCH_RETENTION_DAYS — so no call ever guesses a destructive default.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "dryRun": {
          "description": "Report counts only; delete nothing.",
          "type": "boolean",
        },
        "olderThanDays": {
          "description": "Defaults to ORCH_RETENTION_DAYS.",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer",
        },
      },
      "type": "object",
    },
    "name": "maintenance_prune",
    "outputSchema": {
