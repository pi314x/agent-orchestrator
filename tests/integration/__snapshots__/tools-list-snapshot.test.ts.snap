  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Create or replace a named DAG of steps, validating references, cycles, template targets and file ownership before anything runs. Use plan_create to draft one from a goal, and workflow_start to execute it. Re-defining an existing name replaces its spec; past runs keep the spec they started with.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "inputsSchema": {
          "additionalProperties": {},
          "propertyNames": {
            "type": "string",
          },
          "type": "object",
        },
        "name": {
          "minLength": 1,
          "type": "string",
        },
        "steps": {
          "items": {
            "properties": {
              "agentId": {
                "type": "string",
              },
              "approval": {
                "description": "Pause for a human before this step runs.",
                "type": "boolean",
              },
              "dependsOn": {
                "items": {
                  "type": "string",
                },
                "type": "array",
              },
              "files": {
                "description": "Files this step creates or modifies. Steps with no ordering between them may not claim the same file.",
                "items": {
                  "minLength": 1,
                  "type": "string",
                },
                "type": "array",
              },
              "id": {
                "minLength": 1,
                "type": "string",
              },
              "instruction": {
                "description": "Supports {{inputs.x}} and {{steps.<id>.output}}.",
                "minLength": 1,
                "type": "string",
              },
              "outputSchema": {
                "additionalProperties": {},
                "propertyNames": {
                  "type": "string",
                },
                "type": "object",
              },
              "retries": {
                "maximum": 5,
                "minimum": 0,
                "type": "integer",
              },
              "skillQuery": {
                "type": "string",
              },
              "template": {
                "type": "string",
              },
              "when": {
                "description": "Template; the step is skipped when it renders empty, "false" or "0".",
                "type": "string",
              },
            },
            "required": [
              "id",
              "instruction",
            ],
            "type": "object",
          },
          "minItems": 1,
          "type": "array",
        },
      },
      "required": [
        "name",
        "steps",
      ],
      "type": "object",
    },
