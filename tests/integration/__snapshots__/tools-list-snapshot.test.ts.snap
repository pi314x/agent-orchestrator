                "code": {
                  "enum": [
                    "INVALID_INPUT",
                    "NOT_FOUND",
                    "CONFLICT",
                    "TIMEOUT",
                    "INTERRUPTED",
                    "DEPTH_EXCEEDED",
                    "DEPENDENCY_FAILED",
                    "BUDGET_EXCEEDED",
                    "POLICY_DENIED",
                    "TRANSIENT",
                    "RUNNER_FAILED",
                    "INTERNAL",
                    "REMOTE_REJECTED",
                    "REMOTE_UNVERIFIED",
                    "REMOTE_UNREACHABLE",
