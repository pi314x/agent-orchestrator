    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "shared": {
          "type": "boolean",
        },
      },
      "required": [
        "shared",
      ],
      "type": "object",
    },
    "title": "Share an agent with one user",
  },
  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
