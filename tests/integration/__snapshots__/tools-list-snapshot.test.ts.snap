  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true,
      "readOnlyHint": false,
    },
    "description": "Post a JSON body to a URL whenever one of your jobs or runs settles. The URL is validated up front (public HTTPS, plus ORCH_WEBHOOK_ALLOWED_HOSTS when set) and re-validated at every send; delivery is at-most-once, never retried, and never fails the settlement. A webhook only ever hears about its own owner’s jobs and runs.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "events": {
          "description": "Settle events to post: job.succeeded/failed/cancelled/timed_out, workflow.succeeded/failed.",
          "items": {
            "enum": [
              "job.succeeded",
              "job.failed",
              "job.cancelled",
              "job.timed_out",
              "workflow.succeeded",
              "workflow.failed",
            ],
            "type": "string",
          },
          "minItems": 1,
          "type": "array",
        },
        "url": {
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
