          ],
          "type": "object",
        },
        "draftValid": {
          "description": "True when the draft passes workflow validation.",
          "type": "boolean",
        },
        "job": {
          "additionalProperties": false,
          "properties": {
            "agentId": {
              "type": "string",
            },
            "agentName": {
              "type": "string",
            },
            "attempt": {
              "type": "number",
            },
            "backend": {
              "enum": [
                "local",
                "a2a_remote",
              ],
              "type": "string",
            },
            "createdAt": {
              "type": "string",
            },
            "dependsOn": {
              "items": {
                "type": "string",
              },
              "type": "array",
            },
            "depth": {
              "type": "number",
            },
            "error": {
              "additionalProperties": false,
              "properties": {
                "code": {
                  "enum": [
                    "INVALID_INPUT",
                    "NOT_FOUND",
                    "CONFLICT",
                    "TIMEOUT",
                    "INTERRUPTED",
                    "DEPTH_EXCEEDED",
                    "DEPENDENCY_FAILED",
                    "BUDGET_EXCEEDED",
                    "POLICY_DENIED",
                    "TRANSIENT",
                    "RUNNER_FAILED",
                    "INTERNAL",
                    "REMOTE_REJECTED",
                    "REMOTE_UNVERIFIED",
                    "REMOTE_UNREACHABLE",
                  ],
                  "type": "string",
                },
                "hint": {
                  "type": "string",
                },
                "message": {
                  "type": "string",
                },
              },
              "required": [
                "code",
                "message",
              ],
              "type": "object",
            },
            "finishedAt": {
              "type": "string",
            },
            "instruction": {
              "type": "string",
            },
            "jobId": {
              "type": "string",
            },
            "priority": {
              "type": "number",
            },
            "resultStructured": {},
            "resultText": {
              "type": "string",
            },
            "startedAt": {
              "type": "string",
            },
            "state": {
              "enum": [
                "queued",
                "blocked",
                "running",
                "awaiting_input",
                "succeeded",
                "failed",
                "cancelled",
                "timed_out",
              ],
              "type": "string",
            },
            "updatedAt": {
              "type": "string",
            },
            "usage": {
              "additionalProperties": false,
              "properties": {
