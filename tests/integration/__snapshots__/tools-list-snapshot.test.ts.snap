      "properties": {
        "runners": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "available": {
                "type": "boolean",
              },
              "defaultModel": {
                "type": "string",
              },
              "name": {
                "enum": [
                  "anthropic",
                  "openai-compatible",
                  "cli",
                  "mock",
                  "sampling",
                ],
                "type": "string",
              },
              "reason": {
                "type": "string",
              },
            },
            "required": [
              "name",
              "available",
            ],
            "type": "object",
          },
          "type": "array",
        },
      },
      "required": [
        "runners",
      ],
      "type": "object",
    },
    "title": "List runners",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "List your cron schedules with their next run times. Use schedule_create to add one.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "limit": {
          "maximum": 100,
          "minimum": 1,
          "type": "integer",
        },
      },
      "type": "object",
    },
    "name": "schedule_list",
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "schedules": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "agentId": {
                "type": "string",
              },
              "createdAt": {
                "type": "string",
              },
              "cron": {
                "type": "string",
              },
              "enabled": {
                "type": "boolean",
              },
              "instruction": {
                "type": "string",
              },
              "lastRunAt": {
                "type": "string",
              },
              "model": {
                "type": "string",
              },
              "name": {
                "type": "string",
              },
              "nextRunAt": {
                "type": "string",
              },
              "overlap": {
                "enum": [
                  "allow",
                  "skip",
                ],
                "type": "string",
              },
              "priority": {
                "type": "number",
              },
              "runner": {
                "enum": [
                  "anthropic",
                  "openai-compatible",
                  "cli",
                  "mock",
                  "sampling",
                ],
                "type": "string",
              },
              "scheduleId": {
                "type": "string",
              },
              "template": {
                "type": "string",
              },
              "timeoutSec": {
                "type": "number",
              },
              "timezone": {
                "description": "IANA zone the cron fields match in; omit for UTC.",
                "type": "string",
              },
              "updatedAt": {
                "type": "string",
              },
            },
            "required": [
              "scheduleId",
              "name",
              "cron",
              "instruction",
              "enabled",
              "overlap",
              "nextRunAt",
              "createdAt",
              "updatedAt",
            ],
            "type": "object",
          },
          "type": "array",
        },
      },
      "required": [
        "schedules",
      ],
      "type": "object",
    },
    "title": "List scheduled jobs",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "Show the next fire times for a cron expression (or an existing schedule) without storing anything. Use it to check an expression — including its timezone — before schedule_create, or to see when a schedule fires next.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "count": {
          "description": "How many fire times; defaults to 5.",
          "maximum": 20,
          "minimum": 1,
          "type": "integer",
        },
        "cron": {
          "description": "E.g. "0 9 * * mon-fri".",
          "minLength": 1,
          "type": "string",
        },
        "scheduleId": {
          "description": "Preview this schedule; exactly one of scheduleId or cron.",
          "type": "string",
        },
        "timezone": {
          "description": "IANA zone; a schedule’s own zone wins when scheduleId is given.",
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "schedule_preview",
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "cron": {
          "type": "string",
        },
        "times": {
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "timezone": {
          "type": "string",
        },
      },
      "required": [
        "cron",
        "times",
      ],
      "type": "object",
    },
    "title": "Preview cron fire times",
  },
]
`;
