    "description": "Add an MCP server whose tools local agents may be granted, over stdio or HTTP. Grant them per agent with agent_create toolGrants ("server" for all its tools, "server/tool" for one). Remote A2A agents are opaque and never receive these — this never applies to them.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "allowTools": {
          "description": "Empty means every tool the server offers.",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "authRef": {
          "description": "Env var or secret name holding credentials.",
          "type": "string",
        },
        "denyTools": {
          "description": "Always wins over allowTools.",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "name": {
          "minLength": 1,
          "type": "string",
