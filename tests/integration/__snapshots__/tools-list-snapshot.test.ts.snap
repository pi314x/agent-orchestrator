          "additionalProperties": {},
          "propertyNames": {
            "type": "string",
          },
          "type": "object",
        },
        "priority": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer",
        },
        "runner": {
          "description": "Execution backend for this job, e.g. "cli" to spend your CLI login. Defaults to the deployment default. "sampling" is rejected here — a borrowed model only exists while a request is open, so use delegate.",
          "enum": [
            "anthropic",
            "openai-compatible",
            "cli",
            "mock",
            "sampling",
          ],
          "type": "string",
        },
        "skillQuery": {
          "description": "Free-text match against agent roles and skills.",
          "type": "string",
        },
        "template": {
          "description": "Built-in template name; creates a throwaway agent.",
          "type": "string",
        },
        "timeoutSec": {
          "maximum": 604800,
          "minimum": 1,
          "type": "integer",
        },
      },
      "required": [
        "instruction",
      ],
      "type": "object",
    },
    "name": "job_submit",
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
