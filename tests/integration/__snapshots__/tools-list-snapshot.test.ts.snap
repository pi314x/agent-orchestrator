                "sampling",
              ],
              "type": "string",
            },
            "toolGrants": {
              "items": {
                "type": "string",
              },
              "type": "array",
            },
          },
          "type": "object",
        },
      },
      "required": [
        "agentId",
        "patch",
      ],
      "type": "object",
    },
