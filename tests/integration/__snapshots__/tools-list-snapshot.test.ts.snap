                "CONFLICT",
                "TIMEOUT",
                "INTERRUPTED",
                "DEPTH_EXCEEDED",
                "DEPENDENCY_FAILED",
                "BUDGET_EXCEEDED",
                "POLICY_DENIED",
                "TRANSIENT",
                "RUNNER_FAILED",
                "INTERNAL",
