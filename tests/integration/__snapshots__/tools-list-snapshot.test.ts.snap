                    "job.failed",
                    "job.cancelled",
                    "job.timed_out",
                    "workflow.succeeded",
                    "workflow.failed",
                  ],
                  "type": "string",
                },
                "type": "array",
              },
              "url": {
                "type": "string",
              },
              "webhookId": {
                "type": "string",
              },
            },
            "required": [
              "webhookId",
              "url",
              "events",
              "createdAt",
            ],
            "type": "object",
          },
          "type": "array",
        },
      },
      "required": [
        "webhooks",
      ],
      "type": "object",
    },
    "title": "List completion callbacks",
  },
  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Unregister a completion callback. In-flight deliveries finish; nothing new is sent.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "webhookId": {
          "type": "string",
        },
      },
      "required": [
        "webhookId",
      ],
      "type": "object",
    },
    "name": "webhook_remove",
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "removed": {
          "type": "boolean",
        },
      },
      "required": [
        "removed",
      ],
      "type": "object",
    },
    "title": "Remove a completion callback",
  },
]
`;

exports[`tools/list contract > matches the standard profile snapshot 1`] = `
[
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Define a persistent local agent the orchestrator owns, prompts and runs. Use it when the same role is needed across many jobs; for a one-shot task pass a template to delegate instead. Register agents built by other vendors with agent_register, not this tool.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "enabled": {
          "description": "Start disabled; enable later with agent_update. On by default.",
          "type": "boolean",
        },
        "grantPreset": {
          "description": "Named grant bundle from grant_preset_list, merged with toolGrants. Attaching any grant needs orch:admin.",
          "type": "string",
        },
        "instructions": {
          "description": "System prompt defining the agent behaviour.",
          "minLength": 1,
          "type": "string",
        },
        "limits": {
          "properties": {
            "maxCostUsd": {
              "minimum": 0,
              "type": "number",
            },
            "maxSteps": {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer",
            },
            "timeoutSec": {
              "maximum": 604800,
              "minimum": 1,
              "type": "integer",
            },
          },
          "type": "object",
        },
        "model": {
          "type": "string",
        },
        "name": {
          "description": "Unique name for the agent.",
          "minLength": 1,
          "type": "string",
        },
        "role": {
          "type": "string",
        },
        "runner": {
          "description": "Execution backend; defaults to ORCH_DEFAULT_RUNNER.",
          "enum": [
            "anthropic",
            "openai-compatible",
            "cli",
            "mock",
            "sampling",
          ],
          "type": "string",
        },
        "shared": {
          "description": "Admin only. Visible to and usable by every caller, not just its creator.",
          "type": "boolean",
        },
        "toolGrants": {
          "items": {
            "type": "string",
          },
          "type": "array",
        },
      },
      "required": [
        "name",
        "instructions",
      ],
      "type": "object",
    },
    "name": "agent_create",
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "agent": {
          "additionalProperties": false,
          "properties": {
            "agentId": {
              "type": "string",
            },
            "createdAt": {
              "type": "string",
            },
            "enabled": {
              "type": "boolean",
            },
            "ephemeral": {
              "type": "boolean",
            },
            "instructions": {
              "type": "string",
            },
            "kind": {
              "enum": [
                "local",
                "remote",
              ],
              "type": "string",
            },
            "limits": {
              "additionalProperties": false,
              "properties": {
                "maxCostUsd": {
                  "type": "number",
                },
                "maxSteps": {
                  "type": "number",
                },
                "timeoutSec": {
                  "type": "number",
                },
              },
              "type": "object",
            },
            "model": {
              "type": "string",
            },
            "name": {
              "type": "string",
            },
            "role": {
              "type": "string",
            },
            "runner": {
              "enum": [
                "anthropic",
                "openai-compatible",
                "cli",
                "mock",
                "sampling",
              ],
              "type": "string",
            },
            "shared": {
              "type": "boolean",
            },
            "sharedWithYou": {
              "type": "boolean",
            },
            "toolGrants": {
              "items": {
                "type": "string",
              },
              "type": "array",
            },
          },
          "required": [
            "agentId",
            "kind",
            "name",
            "instructions",
            "toolGrants",
            "limits",
            "shared",
            "sharedWithYou",
            "ephemeral",
