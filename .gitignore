node_modules/
dist/
coverage/
*.log
*.tsbuildinfo

.env
.env.*
!.env.example

# SQLite, in both spellings ORCH_DB_URL is commonly pointed at, plus the
# WAL sidecars — the database is opened in WAL mode.
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db
*.db-shm
*.db-wal

# The default ORCH_DATA_DIR lives in $HOME, but it lands here if anyone points
# it at the checkout.
.agent-orchestrator/

# A literal `~` directory, created when ORCH_DATA_DIR=~/.agent-orchestrator is
# used verbatim as a relative path — the `~` is never expanded, so the live
# database (and anything else the data dir collects) lands in the checkout.
# Whatever is in there must never be committed.
~/

.DS_Store
Thumbs.db
.idea/

# Local Claude Code settings (permissions, hooks) — machine-specific.
.claude/settings.json
