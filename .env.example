# See PLAN.md §12 for the full configuration table.

# Storage — this one variable chooses the backend.
#   unset or a file path -> SQLite (default, single host)
#   postgres://… URL     -> Postgres (several instances, several hosts)
# Nothing else differs: same tools, same stores, same migrations.
ORCH_DATA_DIR=~/.agent-orchestrator

# SQLite (default): the file lives under ORCH_DATA_DIR unless set here.
# ORCH_DB_URL=/absolute/path/orchestrator.sqlite

# Postgres: set this instead, and the server migrates and runs against it.
# ORCH_DB_URL=postgres://orch:secret@db.internal:5432/orchestrator
# ORCH_DB_MAX_CONNECTIONS=10        # pool size per instance; Postgres only

# MCP surface
ORCH_TOOL_PROFILE=full            # core | standard | full
ORCH_TRANSPORT=http               # stdio | http
ORCH_HTTP_HOST=127.0.0.1
ORCH_HTTP_PORT=3333
# Reaching this from a hosted client (ChatGPT, or anything not on this host)
# needs BOTH of these — the bind address alone does not make it reachable:
# ORCH_HTTP_HOST=0.0.0.0
# ORCH_HTTP_ALLOWED_HOSTS=orchestrator.example.com   # the public hostname a
                                                        # reverse proxy forwards
# Browser origins allowed to read this server cross-origin (comma-separated
# exact origins; unset means allow-all). Named here also passes the Origin
# guard. Allow-all means any website can call it — narrow this, or add OAuth,
# before exposing beyond localhost.
# ORCH_CORS_ALLOWED_ORIGINS=https://app.example.com

# Limits
ORCH_MAX_DEPTH=2
ORCH_MAX_CONCURRENCY=4
# History retention for finished jobs and runs (days). Unset keeps everything;
# maintenance_prune deletes older finished history on explicit call.
# ORCH_RETENTION_DAYS=90
# How often due cron schedules are checked (seconds, minimum 5).
# ORCH_SCHEDULE_TICK_SEC=30
# How often an instance checks for jobs another instance asked to cancel
# (seconds, minimum 1, default 2). Far shorter than the 15s lease heartbeat
# on purpose: a cancel is a human waiting, and the check is one cheap read
# over the small running set. The heartbeat itself stays slow — reclaiming
# early runs work twice.
# ORCH_CANCEL_POLL_SEC=2
# Automatic retries per job for transient runner failures (429, 5xx, unreachable).
# ORCH_RUNNER_RETRIES=2
# Hosts completion callbacks may target, beyond the SSRF baseline (public HTTPS
# always required). Empty means any public host.
# ORCH_WEBHOOK_ALLOWED_HOSTS=hooks.example.com

# Execution
ORCH_DEFAULT_RUNNER=openai-compatible   # openai-compatible | anthropic | cli | mock

# Agents defined as Markdown files in the repo. The directory is the source of
# truth: edits land on restart, deleting a file withdraws the agent.
ORCH_AGENTS_DIR=agents
# Specialists excluded from assignment in sensitive repos (comma-separated).
# Excluded names disappear from agent_template_list and are refused on use.
# ORCH_DISABLED_TEMPLATES=security-engineer,cli

# Declarative operator config, applied once at boot (templates, toolservers,
# presets, schedules, budgets — all upsert, so re-applying an unchanged file
# is a no-op). A missing default file is fine; an explicit path that cannot
# be read fails the boot instead.
# ORCH_CONFIG_FILE=orchestrator.config.json

# CLI runner — confined to these directories, nothing outside them runs.
# ORCH_CLI_COMMAND=claude
# ORCH_CLI_ARGS=-p                  # comma-separated; e.g. `exec` for codex
# ORCH_CLI_WORKSPACE_DIRS=/srv/workspaces
# ORCH_CLI_ALLOW_NETWORK=false      # true if the CLI must reach its own backend

# OAuth on the MCP HTTP surface. Unset means no auth, which is the right
# default for a loopback-bound local server.
# ORCH_OAUTH_ISSUER_URL=https://issuer.example.com
# ORCH_OAUTH_RESOURCE_URL=https://orchestrator.example.com/mcp
# ORCH_OAUTH_REQUIRED_SCOPES=mcp
# Skip OIDC discovery and fetch signing keys here instead (for providers
# whose discovery document is unreachable).
# ORCH_OAUTH_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
# App-role values granting orch:admin, comma-separated, matched exactly and
# never lowercased. Needed for issuers like Entra ID that never mint our
# scope name — assign users a role there and name it here.
# ORCH_ADMIN_ROLES=Orchestrator.Admin
# The default runner. There is no LLM in the orchestrator itself: this points
# the adapter at whatever model you run. Any endpoint other than api.openai.com
# needs NO key — set OPENAI_BASE_URL alone and leave OPENAI_API_KEY unset.
# OPENAI_BASE_URL=http://127.0.0.1:8080/v1   # your own gateway, Ollama, vLLM, …
# OPENAI_MODEL is optional for your own endpoint: unset, the model field is
# omitted rather than guessed, so a single-model server just works.
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.6-terra
# OPENAI_BASE_URL=http://localhost:11434/v1   # Ollama, vLLM, LM Studio, OpenRouter

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=sonnet-5

# Logging (always stderr)
ORCH_LOG_LEVEL=info

# A2A interop — talking to agents built by OTHER people, on other frameworks.
# Leave false if every agent you use lives in this repo: the whole a2a_* tool
# group, agent_register and agent_publish then disappear from tools/list.
A2A_ENABLED=false
# Inbound listener: serves /.well-known/agent-card.json and /a2a on this port,
# but only when A2A_ENABLED=true. Loopback-bound, Host- and Origin-validated.
# A2A_HTTP_PORT=3334
# A2A_TRUST_MODE=verified-only    # verified-only | allow-unverified
# A2A_AGENT_CARD_URL=https://example.com/a2a
# A2A_REGISTRY_URL=
# A2A_WEBHOOK_ALLOWED_HOSTS=hooks.example.com

# Post-quantum crypto (NIST FIPS 203 ML-KEM-768, FIPS 204 ML-DSA-65).
# Unset means classical-only, which orchestrator_status reports honestly.
# Generate a data key for at-rest encryption of artifacts + memory values:
#   node --input-type=module -e "import('./dist/core/pqc.js').then(m => console.log(Buffer.from(JSON.stringify(m.generateDataKey())).toString('base64')))"
# Generate an ML-DSA-65 signing key for our published A2A Agent Card:
#   node --input-type=module -e "import('./dist/core/pqc.js').then(m => console.log(Buffer.from(m.generateSigningKeypair().secretKey).toString('base64')))"
# (build first with pnpm build; keep both values like any other secret)
# ORCH_PQC_DATA_KEY=<base64 data-key bundle>
# ORCH_PQC_SIGNING_KEY=<base64 ML-DSA-65 secret key>
# ORCH_PQC_SIGNING_KID=pqc-1
