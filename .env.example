# See PLAN.md §12 for the full configuration table.

# Storage — this one variable chooses the backend.
#   unset or a file path -> SQLite (default, single host)
#   postgres://… URL     -> Postgres (several instances, several hosts)
# Nothing else differs: same tools, same stores, same migrations.
ORCH_DATA_DIR=~/.agent-orchestrator

# SQLite (default): the file lives under ORCH_DATA_DIR unless set here.
# ORCH_DB_URL=/absolute/path/orchestrator.sqlite

# Postgres: set this instead, and the server migrates and runs against it.
# ORCH_DB_URL=postgres://orch:secret@db.internal:5432/orchestrator
# ORCH_DB_MAX_CONNECTIONS=10        # pool size per instance; Postgres only

# MCP surface
ORCH_TOOL_PROFILE=standard        # core | standard | full
ORCH_TRANSPORT=stdio              # stdio | http
ORCH_HTTP_HOST=127.0.0.1
ORCH_HTTP_PORT=3333

# Limits
ORCH_MAX_DEPTH=2
ORCH_MAX_CONCURRENCY=4

# Execution
ORCH_DEFAULT_RUNNER=openai-compatible   # openai-compatible | anthropic | cli | mock

# Agents defined as Markdown files in the repo. The directory is the source of
# truth: edits land on restart, deleting a file withdraws the agent.
ORCH_AGENTS_DIR=agents

# CLI runner — confined to these directories, nothing outside them runs.
# ORCH_CLI_COMMAND=claude
# ORCH_CLI_ARGS=-p                  # comma-separated; e.g. `exec` for codex
# ORCH_CLI_WORKSPACE_DIRS=/srv/workspaces
# ORCH_CLI_ALLOW_NETWORK=false      # true if the CLI must reach its own backend

# OAuth on the MCP HTTP surface. Unset means no auth, which is the right
# default for a loopback-bound local server.
# ORCH_OAUTH_ISSUER_URL=https://issuer.example.com
# ORCH_OAUTH_RESOURCE_URL=https://orchestrator.example.com/mcp
# ORCH_OAUTH_REQUIRED_SCOPES=mcp
# The default runner. There is no LLM in the orchestrator itself: this points
# the adapter at whatever model you run. Any endpoint other than api.openai.com
# needs NO key — set OPENAI_BASE_URL alone and leave OPENAI_API_KEY unset.
# OPENAI_BASE_URL=http://127.0.0.1:8080/v1   # your own gateway, Ollama, vLLM, …
# OPENAI_MODEL is optional for your own endpoint: unset, the model field is
# omitted rather than guessed, so a single-model server just works.
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=http://localhost:11434/v1   # Ollama, vLLM, LM Studio, OpenRouter

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5

# Logging (always stderr)
ORCH_LOG_LEVEL=info

# A2A interop — talking to agents built by OTHER people, on other frameworks.
# Leave false if every agent you use lives in this repo: the whole a2a_* tool
# group, agent_register and agent_publish then disappear from tools/list.
A2A_ENABLED=false
# Inbound listener: serves /.well-known/agent-card.json and /a2a on this port,
# but only when A2A_ENABLED=true. Loopback-bound, Host- and Origin-validated.
# A2A_HTTP_PORT=3334
# A2A_TRUST_MODE=verified-only    # verified-only | allow-unverified
# A2A_AGENT_CARD_URL=https://example.com/a2a
# A2A_REGISTRY_URL=
# A2A_WEBHOOK_ALLOWED_HOSTS=hooks.example.com
